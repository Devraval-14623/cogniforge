generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        String     @id @default(uuid())
  name      String
  email     String     @unique
  password  String
  materials Material[]
  quizAttempts QuizAttempt[]
  createdAt DateTime   @default(now())
}

model Material {
  id         String      @id @default(uuid())
  title      String
  content    String
  summary    String?
  user       User        @relation(fields: [userId], references: [id])
  userId     String
  flashcards Flashcard[]
  quizzes    Quiz[]
  attempts   QuizAttempt[]
  createdAt  DateTime    @default(now())
}

model Flashcard {
  id         String   @id @default(uuid())
  topic      String?
  importance String?
  importanceNote String?
  question   String
  answer     String
  material   Material @relation(fields: [materialId], references: [id])
  materialId String
}

model Quiz {
  id         String   @id @default(uuid())
  question   String
  options    String
  correctAns String
  material   Material @relation(fields: [materialId], references: [id])
  materialId String
}

model QuizAttempt {
  id         String   @id @default(uuid())
  score      Int
  total      Int
  material   Material @relation(fields: [materialId], references: [id])
  materialId String
  user       User     @relation(fields: [userId], references: [id])
  userId     String
  createdAt  DateTime @default(now())
}
