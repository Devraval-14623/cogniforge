# PostgreSQL connection string for the deployed backend.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DB_NAME?schema=public"

# Generate a long random value for the deployed backend.
JWT_SECRET="replace-with-a-long-random-string"

# Required for real summary, flashcard, and quiz generation.
GEMINI_API_KEY="replace-with-your-gemini-api-key"

# Optional frontend origin for CORS. Use the exact deployed frontend origin.
FRONTEND_URL="https://your-frontend.example.com"

PORT=5000
