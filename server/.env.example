# SQLite keeps the project self-contained for local development.
# For hosted production, use a managed PostgreSQL URL and change the Prisma provider accordingly.
DATABASE_URL="file:./dev.db"

# Generate a long random value for any shared deployment.
JWT_SECRET="replace-with-a-long-random-string"

# Required only for the Generate study aids action.
GEMINI_API_KEY="replace-with-your-gemini-api-key"

PORT=5000
